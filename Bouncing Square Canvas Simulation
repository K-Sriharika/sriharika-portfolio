<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Bouncing Square Canvas Simulation</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    :root {
      color-scheme: dark light;
      --bg: #0b1020;
      --panel: #151b30;
      --accent: #5dd8ff;
      --accent-soft: rgba(93, 216, 255, 0.25);
      --text-main: #f5f7ff;
      --text-muted: #a3adc2;
      --border-subtle: rgba(255, 255, 255, 0.08);
      --focus-ring: #ffd36f;
      --shadow-soft: 0 18px 45px rgba(0, 0, 0, 0.55);
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
        sans-serif;
      background: radial-gradient(circle at top, #1a2340, #050712 55%, #02040a);
      color: var(--text-main);
    }

    .app-shell {
      width: 100%;
      max-width: 780px;
      background: radial-gradient(circle at 0 0, #28335a 0, #14192b 40%, #070814);
      border-radius: 18px;
      padding: 1.5rem;
      border: 1px solid var(--border-subtle);
      box-shadow: var(--shadow-soft);
      position: relative;
      overflow: hidden;
    }

    .app-shell::before {
      content: "";
      position: absolute;
      inset: -40%;
      background:
        radial-gradient(circle at 0 0, rgba(93, 216, 255, 0.12), transparent 55%),
        radial-gradient(circle at 100% 0, rgba(255, 211, 111, 0.15), transparent 55%);
      opacity: 0.7;
      pointer-events: none;
      mix-blend-mode: screen;
    }

    .app-inner {
      position: relative;
      z-index: 1;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.2rem;
    }

    .title-block {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    h1 {
      margin: 0;
      font-size: 1.25rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
    }

    .badge {
      font-size: 0.62rem;
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: linear-gradient(120deg, rgba(93, 216, 255, 0.35), rgba(93, 216, 255, 0.02));
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #dff7ff;
    }

    .subtitle {
      margin: 0;
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .controls {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 0.5rem;
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .indicator {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.2rem 0.55rem;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }

    .indicator-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: radial-gradient(circle at 30% 30%, #fff, #ffd36f 33%, #ff9b3d);
      box-shadow: 0 0 8px rgba(255, 211, 111, 0.6);
    }

    .indicator-label {
      opacity: 0.85;
    }

    .canvas-wrapper {
      position: relative;
      border-radius: 14px;
      overflow: hidden;
      background: radial-gradient(circle at 50% -40%, rgba(93, 216, 255, 0.45), transparent 55%),
        radial-gradient(circle at 0 120%, rgba(149, 114, 255, 0.35), transparent 55%),
        radial-gradient(circle at 100% 120%, rgba(255, 131, 91, 0.45), transparent 55%),
        #050711;
      border: 1px solid rgba(255, 255, 255, 0.09);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
    }

    canvas {
      display: block;
      width: 100%;
      max-height: min(60vh, 460px);
      aspect-ratio: 16 / 9;
      outline: none;
      cursor: pointer;
    }

    .canvas-hint {
      position: absolute;
      inset: auto 0 0;
      display: flex;
      justify-content: space-between;
      padding: 0.5rem 0.8rem;
      font-size: 0.72rem;
      color: rgba(233, 238, 255, 0.85);
      background: linear-gradient(to top, rgba(4, 6, 23, 0.92), transparent);
      pointer-events: none;
    }

    .canvas-hint span {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      backdrop-filter: blur(6px);
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
      background: rgba(8, 10, 28, 0.65);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }

    .key-cap {
      padding: 0 0.35rem;
      border-radius: 4px;
      border: 1px solid rgba(255, 255, 255, 0.22);
      background: linear-gradient(145deg, rgba(18, 21, 45, 0.95), rgba(6, 9, 25, 0.95));
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.18);
      font-size: 0.66rem;
    }

    .data-strip {
      margin-top: 0.9rem;
      font-size: 0.72rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 0.9rem;
      color: var(--text-muted);
    }

    .data-pill {
      display: inline-flex;
      align-items: baseline;
      gap: 0.35rem;
      padding: 0.2rem 0.65rem;
      border-radius: 999px;
      background: rgba(6, 10, 32, 0.9);
      border: 1px solid rgba(255, 255, 255, 0.09);
      backdrop-filter: blur(14px);
    }

    .data-label {
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-size: 0.64rem;
      opacity: 0.7;
    }

    .data-value {
      font-variant-numeric: tabular-nums;
      color: #fefefe;
    }

    .data-dot {
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: var(--accent);
      box-shadow: 0 0 8px var(--accent-soft);
      margin-right: 0.25rem;
    }

    @media (max-width: 600px) {
      .app-shell {
        padding: 1rem;
        border-radius: 14px;
      }

      h1 {
        font-size: 1.05rem;
      }

      .subtitle {
        font-size: 0.74rem;
      }

      .canvas-hint {
        font-size: 0.68rem;
      }

      .data-strip {
        font-size: 0.68rem;
      }
    }
  </style>
</head>
<body>
  <main class="app-shell" aria-labelledby="app-title">
    <div class="app-inner">
      <header>
        <div class="title-block">
          <h1 id="app-title">
            <span class="data-dot" aria-hidden="true"></span>
            Bouncing Square Simulation
            <span class="badge" aria-label="Runs entirely in browser">Client-side</span>
          </h1>
          <p class="subtitle">Click or tap the moving square to nudge it and increase its speed.</p>
        </div>
        <div class="controls" aria-hidden="true">
          <div class="indicator">
            <span class="indicator-dot"></span>
            <span class="indicator-label">Running</span>
          </div>
        </div>
      </header>

      <section class="canvas-wrapper">
        <canvas id="sim-canvas" role="img" aria-label="Animated square bouncing inside a rectangle"></canvas>
        <div class="canvas-hint" aria-hidden="true">
          <span><span class="key-cap">Click / Tap</span> Boost direction &amp; speed</span>
          <span>Square changes color on every wall bounce</span>
        </div>
      </section>

      <section class="data-strip" aria-live="polite" aria-atomic="true">
        <div class="data-pill">
          <span class="data-label">Speed</span>
          <span class="data-value"><span id="speed-value">0.00</span> px/frame</span>
        </div>
        <div class="data-pill">
          <span class="data-label">Bounces</span>
          <span class="data-value" id="bounce-count">0</span>
        </div>
        <div class="data-pill">
          <span class="data-label">Clicks</span>
          <span class="data-value" id="click-count">0</span>
        </div>
      </section>
    </div>
  </main>

  <script>
    (function () {
      var canvas = document.getElementById("sim-canvas");
      var ctx = canvas.getContext("2d");

      // Simulation configuration
      var squareSize = 50; // in canvas pixels
      var defaultSpeed = 3.2; // magnitude (px per frame)
      var speedIncreaseFactor = 1.08; // multiplier on user click
      var maxSpeed = 18; // clamp to keep visible and manageable
      var minSpeed = 1.2; // to avoid getting stuck

      // Square state
      var square = {
        x: 0,
        y: 0,
        vx: 0,
        vy: 0,
        size: squareSize,
        color: "#5dd8ff"
      };

      // Stats
      var bounceCount = 0;
      var clickCount = 0;

      var speedValueEl = document.getElementById("speed-value");
      var bounceCountEl = document.getElementById("bounce-count");
      var clickCountEl = document.getElementById("click-count");

      // Resize canvas to maintain crisp drawing independent of CSS scaling
      function resizeCanvas() {
        var rect = canvas.getBoundingClientRect();
        var pixelRatio = window.devicePixelRatio || 1;
        var width = rect.width * pixelRatio;
        var height = rect.height * pixelRatio;

        if (canvas.width !== width || canvas.height !== height) {
          canvas.width = width;
          canvas.height = height;
        }
      }

      // Random color generator with constrained saturation & lightness
      function randomColor() {
        var hue = Math.floor(Math.random() * 360);
        var saturation = 70 + Math.random() * 20; // 70–90%
        var lightness = 50 + Math.random() * 10; // 50–60%
        return "hsl(" + hue + "," + saturation.toFixed(0) + "%," + lightness.toFixed(0) + "%" + ")";
      }

      function randomUnitVector() {
        // Random angle in radians
        var angle = Math.random() * Math.PI * 2;
        return {
          x: Math.cos(angle),
          y: Math.sin(angle)
        };
      }

      function clampMagnitude(vx, vy, minMag, maxMag) {
        var mag = Math.sqrt(vx * vx + vy * vy);
        if (mag === 0) {
          return { vx: minMag, vy: 0 };
        }
        var desired = mag;
        if (mag > maxMag) desired = maxMag;
        if (mag < minMag) desired = minMag;
        var scale = desired / mag;
        return {
          vx: vx * scale,
          vy: vy * scale
        };
      }

      function updateStatsDisplay() {
        var mag = Math.sqrt(square.vx * square.vx + square.vy * square.vy);
        speedValueEl.textContent = mag.toFixed(2);
        bounceCountEl.textContent = String(bounceCount);
        clickCountEl.textContent = String(clickCount);
      }

      function initializeSquare() {
        resizeCanvas();
        var cw = canvas.width;
        var ch = canvas.height;
        // Center position
        square.x = (cw - square.size) / 2;
        square.y = (ch - square.size) / 2;
        // Random initial direction with fixed speed
        var dir = randomUnitVector();
        square.vx = dir.x * defaultSpeed;
        square.vy = dir.y * defaultSpeed;
        square.color = "#5dd8ff";
        updateStatsDisplay();
      }

      function step() {
        var cw = canvas.width;
        var ch = canvas.height;

        // Update position
        square.x += square.vx;
        square.y += square.vy;

        var collided = false;

        // Left wall
        if (square.x < 0) {
          square.x = 0;
          square.vx *= -1;
          collided = true;
        }
        // Right wall
        if (square.x + square.size > cw) {
          square.x = cw - square.size;
          square.vx *= -1;
          collided = true;
        }
        // Top wall
        if (square.y < 0) {
          square.y = 0;
          square.vy *= -1;
          collided = true;
        }
        // Bottom wall
        if (square.y + square.size > ch) {
          square.y = ch - square.size;
          square.vy *= -1;
          collided = true;
        }

        if (collided) {
          bounceCount++;
          square.color = randomColor();
        }

        // Draw
        ctx.clearRect(0, 0, cw, ch);

        // Soft glow behind square
        var glowX = square.x + square.size / 2;
        var glowY = square.y + square.size / 2;
        var glowRadius = square.size * 1.8;
        var gradient = ctx.createRadialGradient(
          glowX,
          glowY,
          0,
          glowX,
          glowY,
          glowRadius
        );
        gradient.addColorStop(0, square.color.replace("hsl", "hsla").replace(")",
          ", 0.75)"));
        gradient.addColorStop(1, "rgba(0, 0, 0, 0)");
        ctx.fillStyle = gradient;
        ctx.fillRect(glowX - glowRadius, glowY - glowRadius, glowRadius * 2, glowRadius * 2);

        // Square
        ctx.fillStyle = square.color;
        ctx.fillRect(square.x, square.y, square.size, square.size);

        // Optional subtle border
        ctx.lineWidth = 1.5;
        ctx.strokeStyle = "rgba(0, 0, 0, 0.4)";
        ctx.strokeRect(square.x + 0.5, square.y + 0.5, square.size - 1, square.size - 1);

        updateStatsDisplay();
        requestAnimationFrame(step);
      }

      function getCanvasRelativePoint(clientX, clientY) {
        var rect = canvas.getBoundingClientRect();
        var pixelRatio = window.devicePixelRatio || 1;
        var x = (clientX - rect.left) * pixelRatio;
        var y = (clientY - rect.top) * pixelRatio;
        return { x: x, y: y };
      }

      function isPointInSquare(px, py) {
        return (
          px >= square.x &&
          px <= square.x + square.size &&
          py >= square.y &&
          py <= square.y + square.size
        );
      }

      function boostSquareDirection() {
        clickCount++;
        // Choose a new random direction
        var dir = randomUnitVector();
        var currentMag = Math.sqrt(square.vx * square.vx + square.vy * square.vy);
        if (currentMag < minSpeed) currentMag = minSpeed;
        var newMag = Math.min(currentMag * speedIncreaseFactor, maxSpeed);
        square.vx = dir.x * newMag;
        square.vy = dir.y * newMag;
        updateStatsDisplay();
      }

      function handlePointerEvent(evt) {
        var point;
        if (evt.touches && evt.touches.length > 0) {
          point = getCanvasRelativePoint(evt.touches[0].clientX, evt.touches[0].clientY);
        } else {
          point = getCanvasRelativePoint(evt.clientX, evt.clientY);
        }

        if (isPointInSquare(point.x, point.y)) {
          evt.preventDefault();
          boostSquareDirection();
        }
      }

      // Accessibility: keyboard interaction to boost speed using Enter/Space
      function handleKeydown(evt) {
        if (evt.code === "Space" || evt.code === "Enter") {
          boostSquareDirection();
        }
      }

      // Ensure the square stays within bounds after a resize
      function handleResize() {
        var prevWidth = canvas.width;
        var prevHeight = canvas.height;
        var prevXRatio = square.x / (prevWidth || 1);
        var prevYRatio = square.y / (prevHeight || 1);

        resizeCanvas();

        var cw = canvas.width;
        var ch = canvas.height;

        // Reposition square proportionally to new canvas size
        square.x = prevXRatio * cw;
        square.y = prevYRatio * ch;

        // Ensure still fully inside
        if (square.x < 0) square.x = 0;
        if (square.y < 0) square.y = 0;
        if (square.x + square.size > cw) square.x = cw - square.size;
        if (square.y + square.size > ch) square.y = ch - square.size;
      }

      // Init
      window.addEventListener("resize", handleResize);

      canvas.addEventListener("click", handlePointerEvent);
      canvas.addEventListener("touchstart", handlePointerEvent, { passive: false });

      canvas.setAttribute("tabindex", "0");
      canvas.addEventListener("keydown", handleKeydown);
      canvas.addEventListener("focus", function () {
        canvas.style.boxShadow = "0 0 0 2px var(--focus-ring)";
      });
      canvas.addEventListener("blur", function () {
        canvas.style.boxShadow = "none";
      });

      // Start
      initializeSquare();
      requestAnimationFrame(step);
    })();
  </script>
</body>
</html>
